---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postInfo } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const info = postInfo(post);
const { Content } = await render(post);
---
<BaseLayout title={info.title} description={info.excerpt}>
  <div class="article-top"><a class="back-link" href="/blog/?open=1">返回目录</a><span>{info.date}</span></div>
  <article class="prose"><Content /></article>
  <div class="article-bottom"><a href="/blog/?open=1">返回目录</a></div>
</BaseLayout>
