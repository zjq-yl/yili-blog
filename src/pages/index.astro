---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const postCount = (await getCollection('blog')).length;
---

<BaseLayout title="首页" description="艺黎的个人网站，收集项目与博客文章。">
  <div class="portal-home">
    <header class="portal-header">
      <a class="portal-logo" href="/" aria-label="艺黎首页">艺黎<span>.</span></a>
      <nav aria-label="主导航">
        <a href="/projects/">项目</a>
        <a href="/blog/">博客文章</a>
      </nav>
    </header>

    <div class="portal-main">
      <p class="portal-eyebrow">YILI · PERSONAL SITE</p>
      <h1>你好，这里是艺黎。</h1>
      <p class="portal-lead">这里放我的项目，也收藏学习与生活中的一些记录。随意看看。</p>

      <div class="portal-sections">
        <a class="portal-card" href="/projects/">
          <span class="portal-card-number">01 / PROJECTS</span>
          <span class="portal-card-title">项目<span aria-hidden="true">↗</span></span>
          <span class="portal-card-description">做过和正在做的东西，慢慢整理在这里。</span>
        </a>
        <a class="portal-card" href="/blog/">
          <span class="portal-card-number">02 / JOURNAL</span>
          <span class="portal-card-title">博客文章<span aria-hidden="true">↗</span></span>
          <span class="portal-card-description">翻开手记，读一读目前的 {postCount} 篇文章。</span>
        </a>
      </div>
    </div>

    <footer class="portal-footer"><span>© {new Date().getFullYear()} 艺黎</span><span>写点日常，记点技术</span></footer>
  </div>
</BaseLayout>
